APP_NAME="Modi And Sons"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://modiandsons.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- SQLite (default, zero setup). For MySQL see README. ---
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=modisons
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Required in production on Vercel: local disk storage doesn't persist there,
# so admin product-image uploads go to Vercel Blob instead. Get this from the
# Vercel dashboard after creating a Blob store and linking it to the project.
BLOB_READ_WRITE_TOKEN=

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="enquiry@modiandsons.com"
MAIL_FROM_NAME="${APP_NAME}"

# Business
BIZ_PHONE="+918048202530"
BIZ_WHATSAPP="918048202530"
BIZ_EMAIL="modiandsons.nathdwara@gmail.com"

# Analytics — leave blank to disable
GA4_ID=
