{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "public/index.php", "use": "vercel-php@0.7.3" },
    { "src": "public/assets/**", "use": "@vercel/static" },
    { "src": "public/robots.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/(.*)", "dest": "/public/index.php" }
  ]
}
